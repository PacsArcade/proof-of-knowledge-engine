# ===========================================================================
# Bitcoin Core Configuration
# Server: AMD EPYC 7763 / 105 GB RAM / 2 TB Disk
# Bind IP: 194.156.89.144 (3rd IP - dedicated Bitcoin stack)
# ===========================================================================

# ---------------------------------------------------------------------------
# Network Settings
# ---------------------------------------------------------------------------

# Bind P2P to 3rd IP only - isolates from game server traffic
bind=194.156.89.144

# Standard Bitcoin P2P port
port=8333

# Max peer connections (40 is balanced for bandwidth vs network contribution)
maxconnections=40

# Limit daily upload to ~500 MB to preserve bandwidth for game servers
# Remove this line if you want to fully contribute to the network
maxuploadtarget=500

# ---------------------------------------------------------------------------
# RPC Settings (for local services: electrum, block explorer, ord, etc.)
# ---------------------------------------------------------------------------

# Enable RPC server
server=1

# RPC binds to localhost ONLY - never expose to network
rpcbind=127.0.0.1
rpcport=8332
rpcallowip=127.0.0.1/32

# RPC authentication (generated by setup script - DO NOT EDIT MANUALLY)
# The rpcauth line will be appended by the setup script
# Format: rpcauth=<user>:<salt>$<hash>

# ---------------------------------------------------------------------------
# Performance Tuning (optimized for your hardware)
# ---------------------------------------------------------------------------

# UTXO database cache in MB
# 8 GB significantly speeds up Initial Block Download
# After sync, can reduce to 1024 (1 GB) to free RAM
dbcache=8192

# Parallel script verification threads
# 8 is optimal - leaves 56 cores free for game servers
par=8

# ---------------------------------------------------------------------------
# Indexes (REQUIRED for block explorer, ordinals, electrum)
# ---------------------------------------------------------------------------

# Full transaction index - allows looking up any transaction by txid
txindex=1

# Compact block filters (BIP157) - enables light client support
blockfilterindex=1

# Coinstats index - enables advanced UTXO statistics
coinstatsindex=1

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------

# Log to file instead of stdout
debuglogfile=/opt/bitcoin/data/debug.log

# Shrink debug log when it exceeds 50 MB
shrinkdebugfile=1

# ---------------------------------------------------------------------------
# Mempool
# ---------------------------------------------------------------------------

# Max mempool size in MB (default 300)
maxmempool=512

# Minimum relay fee (default)
minrelaytxfee=0.00001

# ---------------------------------------------------------------------------
# Data Directory
# ---------------------------------------------------------------------------
# Set via command line in systemd service: -datadir=/opt/bitcoin/data
