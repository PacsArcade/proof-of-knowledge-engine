# Local build recipe for paradust7/luanti-wasm (MIT). Their Dockerfile omits Node 24, which
# install_emsdk.sh now requires, so this adds it (checksum pinned) and is otherwise the same.
FROM ubuntu:22.04
RUN apt-get update && DEBIAN_FRONTEND=noninteractive TZ=Etc/UTC apt-get install -y \
    wget ca-certificates xz-utils python3 git build-essential cmake tclsh zip zstd gettext
RUN wget -q https://nodejs.org/dist/v24.21.0/node-v24.21.0-linux-x64.tar.xz \
 && echo "fd8e59d5a511510f6a298afb548f18c7d2b1be404d8b4a27d94fbe49f56cb2d6  node-v24.21.0-linux-x64.tar.xz" | sha256sum -c - \
 && tar -xJf node-v24.21.0-linux-x64.tar.xz -C /usr/local --strip-components=1
COPY . /luanti-wasm
RUN cd /luanti-wasm && ./install_emsdk.sh
# build_all is run by hand so a failure can be inspected:
#   podman run --name pa-wasm-build IMAGE bash -c "cd /luanti-wasm && ./build_all.sh"
