# Normalize line endings. Scripts run on Arch Linux — keep them LF even on Windows checkouts.
* text=auto eol=lf

*.sh    text eol=lf
*.py    text eol=lf
*.sql   text eol=lf
*.lua   text eol=lf
*.md    text eol=lf
*.yaml  text eol=lf
*.yml   text eol=lf
*.conf  text eol=lf
Makefile text eol=lf

# Binaries — never touch.
*.png binary
*.jpg binary
*.zim binary
*.gguf binary
*.safetensors binary
