# Pac's Arcade — Proof of Knowledge Engine (P.O.K.E.) — node config
# Copy to `.env` and let `scripts/node-doctor.sh` / the node-wizard fill the blanks.
# Nothing here should ever be committed. Offline-first: no value phones home.

# --- Identity & network -------------------------------------------------------
PA_NODE_NAME="my-first-verse"
PA_NODE_PUBKEY=                       # generated on first bootstrap; also your discovery key
PA_MATRIX_SERVER_NAME=verse.local     # your homeserver domain (can be a .onion or LAN name)
PA_FRENS_URL=                         # frens.earth verse URL; empty = standalone node (MUD skips @fren onboarding)

# --- Money safety (READ docs/SECURITY.md before touching) ---------------------
PA_NETWORK=regtest                    # regtest | testnet | mainnet  (mainnet is GATED)
PA_MAINNET_ACK=false                  # must be true AND security review passed for mainnet
PA_SEED_LOOT_ENABLED=false            # seed-phrase-as-loot mechanic; off until you opt in

# --- Inference (the node-wizard sets these based on your hardware) -------------
PA_INFERENCE_BACKEND=ollama           # ollama | vllm  (compose profile of the same name)
PA_INFERENCE_BASE_URL=http://inference:11434/v1
                                      # NOTE: vLLM serves on :8000 — if PA_INFERENCE_BACKEND=vllm
                                      # set this to http://inference:8000/v1
PA_GEN_MODEL=                         # e.g. a quantized 7-8B chat model that fits your VRAM
PA_EMBED_MODEL=nomic-embed-text       # embedding model for the pgvector guardrail

# --- Corpus (DB-1) ------------------------------------------------------------
PA_CORPUS=simple-wikipedia            # simple-wikipedia | en-wikipedia | curated
PA_CORPUS_TORRENT=true                # join the shared corpus mesh (COLD tier, background)
PA_GUARDRAIL_THRESHOLD=0.78           # cosine floor; below this, content is quarantined

# --- Knowledge swarm (BitTorrent corpus mesh; see docs/CORPUS-MESH.md) ---------
PA_COMMON_KNOWLEDGE=common-knowledge  # corpus_id of the canonical shared swarm Pac's Arcade seeds
PA_COMMON_KNOWLEDGE_MAGNET=           # magnet/infohash bootstrapping the common swarm (filled once seeded)
PA_COMMON_KNOWLEDGE_PUBKEY=           # pinned key that MUST have signed the common manifest (trust anchor)
PA_TORRENT_PORT=6881                  # libtorrent listen port
PA_CORPUS_CACHE_GB=8                  # LRU byte budget for resident shards
PA_CORPUS_DATA_DIR=/corpus/shards     # on-disk shard store
PA_TORRENT_TRACKERS=                  # optional comma-separated trackers (DHT is primary)
PA_MANIFEST_SIGNING_KEY=/corpus/keys/manifest_ed25519.key  # seed node's signing key (never in git)
PA_RELAYS_FILE=data/relays.json       # verse subscriptions (nostr-relay-style); shared by corpus + MUD console

# --- Databases ----------------------------------------------------------------
# Services read the full URLs. Compose can't destructure a URL, so it also reads
# the discrete parts below — keep the two in sync (same user/password/name/host).
PA_DB2_URL=postgresql://arcade:change-me@postgres-gamestate:5432/gamestate
PA_DB1_URL=postgresql://arcade:change-me@postgres-source:5433/source
PA_DB2_USER=arcade
PA_DB2_PASSWORD=change-me
PA_DB2_NAME=gamestate
PA_DB1_USER=arcade
PA_DB1_PASSWORD=change-me
PA_DB1_NAME=source

# --- Bitcoin (regtest by default) ---------------------------------------------
PA_BITCOIN_RPC=http://arcade:change-me@bitcoin:18443
PA_BITCOIN_RPC_USER=arcade
PA_BITCOIN_RPC_PASSWORD=change-me

# --- Class-certificate runes (soulbound; see docs/RUNES.md) -------------------
# One Bitcoin rune per class, etched to the student's wallet, soulbound-by-convention.
# Regtest + an `ord` indexer for dev. Etch/issuance fees paid by the non-profit treasury.
PA_ORD_URL=http://ord:8080            # runes-aware ord indexer/server
PA_TREASURY_WALLET=arcade-treasury    # non-profit wallet that etches class runes + pays fees

# --- Inter-service endpoints (container service DNS; defaults are fine locally) ---
PA_STATE_SYNC_URL=http://state-sync:8082
PA_MATRIX_HOMESERVER_URL=http://matrix:8008
PA_ORCHESTRATOR_URL=http://orchestrator:8080
PA_GUARDRAIL_URL=http://guardrail:8081

# --- MUD (dev mode: leave STATE_SYNC empty above to run the in-memory world) ---
PA_MUD_HOST=127.0.0.1                 # bind address for `python services/mud/server.py`
PA_MUD_PORT=4000                      # telnet port
PA_MUD_WS_PORT=4002                   # browser WebSocket bridge — play POKEMUD in a browser at :4001/play
PA_LOCAL_SITE_URL=                    # your physically-local pacsarcade-area website (linked from console + game)
PA_GAMESTATE_BACKEND=sqlite           # sqlite (dev) | postgres (prod, uses PA_DB2_URL)
PA_GAMESTATE_SQLITE=data/gamestate.dev.sqlite   # dev world-state file (gitignored)

# --- MUD operator console / web-admin rails ----------------------------------
PA_ADMIN_TOKEN=                       # in-MUD/HTTP admin token; auto-generated + printed if empty
PA_MUD_ADMIN_HOST=127.0.0.1           # HTTP control rails bind (localhost-only by default)
PA_MUD_ADMIN_PORT=4001
PA_CHAT_MATRIX=off                    # route in-MUD `say` to the Matrix verse room (default off = local-only)
PA_MATRIX_BRIDGE_URL=http://matrix-bridge:8084
PA_CORPUS_URL=http://corpus:8083      # for the knowledge-swarm `nodes` health report
PA_SWARM_MOCK=false                   # demo: show mock swarm health when the corpus service is down
